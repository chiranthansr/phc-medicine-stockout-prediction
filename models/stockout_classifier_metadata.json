{
  "project": "AI-Based Medicine Stock-Out Prediction and Inventory Management System for PHCs",
  "model_type": "LogisticRegression_balanced",
  "task": "next-day Stockout_Flag classification",
  "target": "Stockout_Next_Day",
  "features_numeric": [
    "Patient_Visits",
    "Emergency_Flag",
    "Crisis_Flag",
    "Target_Crisis_Flag",
    "Expected_Target_Patient_Visits",
    "Demand_Deviation_Percent",
    "Persistent_Demand_Shift_Flag",
    "Lag_1_Demand",
    "Lag_7_Demand",
    "Avg_7_Day_Demand",
    "Avg_30_Day_Demand",
    "Avg_90_Day_Demand",
    "Consumption_Trend_Ratio_7d_to_30d",
    "Patient_Visits_Avg_7d",
    "Patient_Visits_Lag_1",
    "Patient_Visits_Change_1d",
    "Demand_Rolling_7d_Std",
    "Lag_14_Demand",
    "Closing_Stock",
    "Minimum_Stock_Level",
    "Reorder_Level",
    "Supplier_Lead_Time_Days",
    "Days_Since_Last_Delivery",
    "Days_To_Nearest_Expiry",
    "Previous_Stockouts_Last_7_Days",
    "Stock_Cover_Days",
    "Stock_to_Reorder_Ratio"
  ],
  "features_categorical": [
    "PHC_ID",
    "Medicine_ID",
    "Target_Day_Of_Week",
    "Target_Month"
  ],
  "label_definition": "Stockout_Flag in synthetic inventory on Target_Date, joined by PHC_ID and Medicine_ID.",
  "class_imbalance": {
    "train_positive": 43,
    "validation_positive": 19,
    "test_positive": 14
  },
  "selected_on": "Average precision (PR AUC) on chronological validation split only",
  "threshold": 0.65,
  "threshold_selection": "Grid search maximizing validation F1; ties select higher threshold; test not used for threshold selection.",
  "source_data": "SYNTHETIC ONLY; not validated on real PHC records.",
  "real_world_accuracy_validated": false,
  "python_version": "3.13.5",
  "scikit_learn_version": "1.8.0"
}